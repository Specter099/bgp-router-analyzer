# Secrets and local data — must never enter the build context.
routers.json
routers.yaml
.env
*.db
*.db-wal
*.db-shm
*.pem
*.key

# Local environments and build output (the image builds its own).
.venv/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
*.egg-info/
ui/node_modules/
ui/dist/
ui/*.tsbuildinfo

# Repo metadata not needed at runtime. docs/ holds README screenshots, which
# would otherwise ship ~0.5MB into the build context for no reason.
.git/
.github/
tasks/
docs/
*.md
!README.md
