# Copy to .env and fill in. .env is gitignored.

# Required. Authenticates API clients (X-API-Key) and the admin UI login.
# Generate one with: openssl rand -hex 32
BGP_ANALYZER_API_KEY=

# Router password fallback for routers.json entries that omit "password".
# BGP_ROUTER_PASSWORD=

# Set to 1 when TLS terminates at a reverse proxy in front of this container.
# Without it the app only sees HTTP and will never mark session cookies Secure.
# BGP_ASSUME_TLS=1

# Optional tuning.
# BGP_POLL_WORKERS=5          # concurrent router SSH polls
# BGP_SESSION_TTL=28800       # absolute session lifetime (seconds)
# BGP_SESSION_IDLE=1800       # session idle timeout (seconds)
# BGP_ENABLE_DOCS=            # set to 1 to expose /docs and /redoc
